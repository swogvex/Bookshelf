---
const { book, loading = "lazy" } = Astro.props;

const COVER_BASE_URL = import.meta.env.PUBLIC_COVER_BASE_URL;
const coverSlug = String(book.data.cover).replace(/\.webp$/i, "");
const coverUrl = `${COVER_BASE_URL}/Books/${coverSlug}.webp`;
---

<article class="book-card" data-book-id={book.id}>
  <button class="book-link" data-book-slug={book.id}>
    <div class="book">
      <div class="book-cover">
        <img
          src={coverUrl}
          alt={book.data.title}
          class="cover-img"
          width={225}
          height={350}
          loading={loading}
        />
        <div class="effect"></div>
        <div class="light"></div>
      </div>
      <div class="book-inside"></div>
    </div>
  </button>
</article>

<style>
  .book-card {
    position: relative;
  }

  .book-link {
    display: block;
    width: 100%;
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
    color: inherit;
    text-decoration: none;
  }

  /* Igual que el original: contenedor relativo con tamaño propio.
     Adaptación: en vez de 225px/350px fijos, uso % + aspect-ratio
     para que respete tu grid responsive. */
  .book {
    position: relative;
    width: 100%;
    aspect-ratio: 225 / 350; /* misma proporción que el original */
    text-align: center;
  }

  /* --- .book-cover: idéntico al original --- */
  .book-cover {
    position: absolute;
    z-index: 1;
    width: 100%;
    height: 100%;
    inset: 0;
    transform-origin: 0 50%;
    background: #111; /* mismo fallback oscuro del original */
    border-radius: 3px;
    overflow: hidden; /* necesario para que la img no se salga del radio */
    backface-visibility: hidden;
    box-shadow:
      inset 4px 1px 3px #ffffff60,
      inset 0 -1px 2px #00000080,
      2px 3px 5px rgba(0, 0, 0, 0.16);
    transition:
      transform 0.35s ease-in-out,
      box-shadow 0.35s ease-in-out;
  }

  .book-cover::before,
  .book-cover::after {
    content: "";
    position: absolute;
    z-index: 3;
    pointer-events: none;
  }

  .book-cover::before {
    top: 0;
    left: 10px;
    width: 20px;
    height: 100%;
    margin-left: 0;
    border-left: 2px solid rgba(0, 0, 0, 0.06);
    background-image: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.2) 0%,
      rgba(255, 255, 255, 0) 100%
    );
    transition: width 0.35s ease;
  }

  .book-cover::after {
    top: 0;
    right: 0;
    width: 90%;
    height: 100%;
    border-radius: 3px;
    background-image: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.2) 100%
    );
    opacity: 0.1;
    transition:
      width 0.35s ease,
      opacity 0.35s ease;
  }

  /* Adaptación: la imagen de portada ocupa el 100% del .book-cover,
     equivalente a "background-size: 100% 100%" del original. */
  .cover-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: fill; /* 100% 100%, igual que el original */
    display: block;
  }

  /* --- .effect: idéntico al original --- */
  .effect {
    display: none;
  }

  /* --- .light: idéntico al original --- */
  .light {
    display: none;
  }

  .book:hover {
    cursor: pointer;
  }

  /* --- Hover de la tapa: mismos valores que el original (-30deg) --- */
  .book:hover .book-cover {
    transform: perspective(2000px) rotateY(-30deg);
    transform-style: preserve-3d;
    box-shadow:
      inset 4px 1px 3px #ffffff60,
      inset 0 -1px 2px #00000080,
      10px 0px 10px -5px #00000030,
      3px 7px 10px rgba(0, 0, 0, 0.12);
  }

  .book:hover .effect {
    display: none;
  }

  .book:hover .light {
    display: none;
  }

  .book:hover .book-cover::before {
    width: 40px;
  }

  .book:hover .book-cover::after {
    width: 70%;
    opacity: 1;
  }

  .book-link:active .book {
    transform: scale(0.988);
  }

  .book-link:active .book-cover {
    transform: perspective(2000px) rotateY(-30deg) scale(0.988);
    box-shadow:
      inset 4px 1px 3px #ffffff60,
      inset 0 -1px 2px #00000080,
      1px 1px 3px rgba(0, 0, 0, 0.2);
  }

  .book-link:active .book-cover::before {
    width: 34px;
  }

  .book-link:active .book-cover::after {
    width: 62%;
    opacity: 0.85;
  }

  @media (hover: none), (pointer: coarse) {
    .book,
    .book-cover,
    .book-cover::before,
    .book-cover::after {
      transition: none !important;
      transform: none !important;
    }

    .book:hover .book-cover,
    .book-link:active .book-cover {
      transform: none !important;
    }

    .book:hover .book-cover::before,
    .book-link:active .book-cover::before {
      width: 20px;
    }

    .book:hover .book-cover::after,
    .book-link:active .book-cover::after {
      width: 90%;
      opacity: 0.1;
    }
  }

  /* --- .book-inside: mismo truco de "páginas" con box-shadow escalonado.
     Recoloreado para que se note más (blanco puro / beige) y termina
     en un tono oscuro (última "hoja" = contratapa negra/gris). --- */
  .book-inside {
    position: absolute;
    width: calc(100% - 2px);
    height: 96%;
    top: 2%;
    left: 1px;
    border: 1px solid grey;
    border-radius: 3px;
    background: white;
    box-shadow:
      10px 40px 40px -10px #00000030,
      inset -2px 0 0 grey,
      inset -3px 0 0 #dbdbdb,
      inset -4px 0 0 white,
      inset -5px 0 0 #dbdbdb,
      inset -6px 0 0 white,
      inset -7px 0 0 #dbdbdb,
      inset -8px 0 0 white,
      inset -9px 0 0 #dbdbdb,
      inset -10px 0 0 white,
      inset -11px 0 0 #dbdbdb;
  }
</style>
