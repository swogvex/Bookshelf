<div id="window-manager"></div>

<style is:global>
  #window-manager {
    position: fixed;
    inset: 0;
    z-index: 1000;
    pointer-events: none;
  }

  .book-window {
    position: absolute;
    width: min(680px, calc(100vw - 16px));
    background: white;
    border: 1px solid var(--text);
    color: var(--text);
    pointer-events: auto;
    overflow: visible;
  }

  .book-window::before,
  .book-window::after {
    content: "";
    position: absolute;
    z-index: 0;
    background-image: repeating-linear-gradient(
      135deg,
      transparent 0 3px,
      var(--text) 3px 4px
    );
    pointer-events: none;
  }

  .book-window::before {
    top: 0;
    left: 100%;
    width: 8px;
    height: calc(100% + 8px);
  }

  .book-window::after {
    top: 100%;
    left: 0;
    width: calc(100% + 8px);
    height: 8px;
  }

  .book-window__header {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
    padding: 0 1rem;
    background: white;
    border-bottom: 1px solid var(--border);
    cursor: move;
    user-select: none;
    touch-action: none;
  }

  .book-window__scroll {
    display: block;
    max-height: min(480px, calc(100dvh - 96px));
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-gutter: stable;
  }

  .book-window__bottom-mask {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    z-index: 4;
    width: calc(100% - 1px);
    height: 1rem;
    background: white;
    pointer-events: none;
  }

  .book-window__nav,
  .book-window__actions {
    display: flex;
    gap: 0.75rem;
  }

  .book-window button {
    padding: 0.15rem;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
    font-size: 1.35rem;
    line-height: 1;
  }

  .book-window button svg {
    display: block;
    width: 1.1rem;
    height: 1.1rem;
  }

  .book-window button:hover {
    opacity: 0.55;
  }

  .book-window__content {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    gap: 2rem;
    padding: 1.5rem;
  }

  .book-window__cover-frame {
    position: relative;
    align-self: start;
    width: 100%;
    background: #111;
    border-radius: 3px;
    overflow: hidden;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.24),
      inset 0 0 0 2px rgba(0, 0, 0, 0.22),
      0 0 0 1px rgba(0, 0, 0, 0.2),
      2px 3px 5px rgba(0, 0, 0, 0.16);
  }

  .book-window__cover-frame::before,
  .book-window__cover-frame::after {
    content: "";
    position: absolute;
    z-index: 1;
    pointer-events: none;
  }

  .book-window__cover-frame::before {
    top: 0;
    left: 10px;
    width: 20px;
    height: 100%;
    border-left: 2px solid rgba(0, 0, 0, 0.06);
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.2) 0%,
      rgba(255, 255, 255, 0) 100%
    );
  }

  .book-window__cover-frame::after {
    top: 0;
    right: 0;
    width: 90%;
    height: 100%;
    border-radius: 3px;
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.2) 100%
    );
    opacity: 0.1;
  }

  .book-window__cover {
    position: relative;
    z-index: 0;
    display: block;
    width: 100%;
    height: auto;
  }

  .book-window__author {
    margin: 0;
    opacity: 0.7;
    font-size: 0.95rem;
  }

  .book-window__title {
    margin: 0.75rem 0 1rem;
    font-size: clamp(1.6rem, 3vw, 2rem);
    line-height: 1.1;
  }

  .book-window__meta {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 1rem;
    opacity: 0.7;
    font-size: 0.9rem;
  }

  .book-window__genres {
    display: none;
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    z-index: 2;
    padding: 0.5rem 0.75rem;
    background: var(--text);
    color: var(--bg);
    border-radius: 4px;
    white-space: nowrap;
  }

  .book-window__meta span:last-child:hover .book-window__genres {
    display: block;
  }

  .rating-star {
    width: 0.9rem;
    height: 0.9rem;
    vertical-align: -0.1rem;
  }

  .rating-star--filled {
    fill: currentColor;
  }

  .book-window__body {
    margin: 1.5rem 0 0;
    line-height: 1.5;
    white-space: pre-line;
    overflow-wrap: anywhere;
  }

  @media (max-width: 600px) {
    .book-window {
      position: absolute;
      width: calc(100vw - 16px);
      max-height: none;
      overflow: visible;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
    }

    .book-window__scroll {
      max-height: min(630px, calc(100dvh - 96px));
      overflow-y: auto;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
    }

    .book-window__header {
      cursor: default;
      touch-action: auto;
    }

    .book-window__content {
      display: block;
      min-width: 0;
      padding: 1rem;
    }

    .book-window__cover-frame {
      width: min(155px, 48vw);
      margin: 0 auto 1.5rem;
    }

    .book-window__title {
      margin-top: 0.5rem;
      font-size: 1.35rem;
    }
  }
</style>

<script>
  // @ts-nocheck
  import { ArrowLeft, ArrowRight, Share2, Star, X, createIcons } from "lucide";
  import Lenis from "lenis";

  const COVER_BASE_URL = import.meta.env.PUBLIC_COVER_BASE_URL;

  const openWindows = new Map();
  let nextZIndex = 1;
  let offsetCount = 0;
  const windowScrollers = new WeakMap();

  function getManager() {
    return document.getElementById("window-manager");
  }

  function getBooks() {
    return window.booksData || [];
  }

  function requiredElement(parent, selector) {
    const element = parent.querySelector(selector);
    if (!element) throw new Error(`Missing window element: ${selector}`);
    return element;
  }

  function renderIcons(windowElement) {
    createIcons({
      root: windowElement,
      icons: { ArrowLeft, ArrowRight, Share2, Star, X },
      attrs: { "stroke-width": 1.5 },
    });
  }

  function focusWindow(windowElement) {
    windowElement.style.zIndex = String(nextZIndex++);
  }

  function shouldUseReducedMotion() {
    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  }

  function shouldUseSmoothScroll() {
    return (
      !window.matchMedia("(pointer: coarse)").matches &&
      !window.matchMedia("(max-width: 767px)").matches &&
      !shouldUseReducedMotion()
    );
  }

  function startWindowScroll(windowElement) {
    if (!shouldUseSmoothScroll()) {
      return;
    }

    const scrollElement = requiredElement(
      windowElement,
      ".book-window__scroll",
    );
    const scroller = new Lenis({
      wrapper: scrollElement,
      content: scrollElement.firstElementChild,
      lerp: 0.08,
      wheelMultiplier: 0.8,
      smoothWheel: true,
      syncTouch: true,
    });
    let animationFrame;

    function raf(time) {
      scroller.raf(time);
      animationFrame = requestAnimationFrame(raf);
    }

    animationFrame = requestAnimationFrame(raf);
    windowScrollers.set(windowElement, {
      destroy() {
        cancelAnimationFrame(animationFrame);
        scroller.destroy();
      },
    });
  }

  function stopWindowScroll(windowElement) {
    windowScrollers.get(windowElement)?.destroy();
    windowScrollers.delete(windowElement);
  }

  function renderBook(windowElement, book) {
    const genres = book.genres || [];
    const stars = Array.from(
      { length: 5 },
      (_, index) =>
        `<i data-lucide="star" class="rating-star${index < book.rating ? " rating-star--filled" : ""}"></i>`,
    ).join("");
    const category = genres[0] || "";
    const extraGenres = genres.length > 1 ? `+${genres.length - 1}` : "";

    const cover = requiredElement(windowElement, ".book-window__cover");
    const coverSlug = String(book.cover).replace(/\.webp$/i, "");
    cover.src = `${COVER_BASE_URL}/Books/${coverSlug}.webp`;
    cover.alt = book.title;
    requiredElement(windowElement, ".book-window__author").textContent =
      book.author;
    requiredElement(windowElement, ".book-window__title").textContent =
      book.title;
    requiredElement(windowElement, ".book-window__body").textContent =
      book.body;
    requiredElement(windowElement, ".book-window__meta").innerHTML = `
			<span>${stars}</span>
			<span>${book.finishedAt}</span>
			<span>
				${category} ${extraGenres}
				<span class="book-window__genres">${genres.join(", ")}</span>
			</span>
		`;
    windowElement.dataset.slug = book.id;
    windowElement.dataset.type = "book";
  }

  function renderWriting(windowElement, writing) {
    const title = requiredElement(windowElement, ".book-window__title");
    const body = requiredElement(windowElement, ".book-window__body");
    const meta = requiredElement(windowElement, ".book-window__meta");

    title.textContent = writing.title;
    meta.innerHTML = `<span>${writing.date}</span>`;
    body.innerHTML = "";

    const template = document.getElementById(`writing-template-${writing.id}`);
    if (template && template.content) {
      const content = template.content.cloneNode(true);
      body.appendChild(content);
    } else {
      const fallback = document.createElement("div");
      fallback.innerHTML = writing.content || "";
      body.appendChild(fallback);
    }

    windowElement.dataset.slug = writing.id;
    windowElement.dataset.type = "writing";
  }

  function getFilteredBooks() {
    const filteredIds = Array.isArray(window.currentFilteredBookIds)
      ? window.currentFilteredBookIds
      : getBooks().map((book) => book.id);

    const booksById = new Map(getBooks().map((book) => [book.id, book]));
    return filteredIds.map((id) => booksById.get(id)).filter(Boolean);
  }

  function getWritings() {
    return Array.isArray(window.writingsData) ? window.writingsData : [];
  }

  function changeWindow(windowElement, direction) {
    const type = windowElement.dataset.type || "book";
    const entries = type === "writing" ? getWritings() : getFilteredBooks();
    const currentIndex = entries.findIndex(
      (entry) => entry.id === windowElement.dataset.slug,
    );
    if (currentIndex === -1) return;

    const nextEntry = entries[currentIndex + direction];
    if (!nextEntry) return;

    openWindows.delete(windowElement.dataset.slug);
    if (type === "writing") {
      renderWriting(windowElement, nextEntry);
    } else {
      renderBook(windowElement, nextEntry);
    }
    renderIcons(windowElement);
    openWindows.set(nextEntry.id, windowElement);
  }

  function makeDraggable(windowElement) {
    const header = requiredElement(windowElement, ".book-window__header");

    header.addEventListener("pointerdown", (event) => {
      if (event.target instanceof Element && event.target.closest("button")) {
        return;
      }

      event.preventDefault();
      focusWindow(windowElement);
      header.setPointerCapture(event.pointerId);

      const startX = event.clientX;
      const startY = event.clientY;
      const startLeft = windowElement.offsetLeft;
      const startTop = windowElement.offsetTop;

      function moveWindow(moveEvent) {
        windowElement.style.left = `${startLeft + moveEvent.clientX - startX}px`;
        windowElement.style.top = `${startTop + moveEvent.clientY - startY}px`;
      }

      function stopMoving() {
        header.removeEventListener("pointermove", moveWindow);
        header.removeEventListener("pointerup", stopMoving);
        header.removeEventListener("pointercancel", stopMoving);
      }

      header.addEventListener("pointermove", moveWindow);
      header.addEventListener("pointerup", stopMoving, { once: true });
      header.addEventListener("pointercancel", stopMoving, { once: true });
    });
  }

  function openBook(slug) {
    const manager = getManager();
    if (!manager) return;

    document.querySelector(".book-filters")?.classList.remove("is-open");

    if (openWindows.has(slug)) {
      focusWindow(openWindows.get(slug));
      return;
    }

    const isMobile = window.innerWidth < 768;
    const shouldAnimateWindow = !isMobile && !shouldUseReducedMotion();
    if (isMobile) {
      openWindows.forEach((windowElement) => {
        stopWindowScroll(windowElement);
        windowElement.remove();
      });
      openWindows.clear();
    }

    const book = getBooks().find((item) => item.id === slug);
    if (!book) return;

    const windowElement = document.createElement("section");
    windowElement.className = "book-window";
    const offset = (offsetCount++ % 5) * 40;
    const maxLeft = Math.max(8, window.innerWidth - 696);
    const maxTop = Math.max(8, window.innerHeight - 500);
    windowElement.style.left = `${Math.min(120 + offset, maxLeft)}px`;
    const top = isMobile
      ? Math.min(120 + offset, Math.max(20, window.innerHeight * 0.12))
      : Math.min(120 + offset, maxTop);
    windowElement.style.top = `${top}px`;
    if (isMobile) {
      windowElement.style.maxHeight = `calc(100dvh - ${top + 8}px)`;
      windowElement.style.transition = "none";
    }
    if (!shouldAnimateWindow) {
      windowElement.style.transition = "none";
    }
    windowElement.innerHTML = `
      <div class="book-window__scroll">
      <div class="book-window__header">
				<div class="book-window__nav">
            <button class="book-window__prev" aria-label="Previous book"><i data-lucide="arrow-left"></i></button>
            <button class="book-window__next" aria-label="Next book"><i data-lucide="arrow-right"></i></button>
				</div>
				<div class="book-window__actions">
            <button class="book-window__share" aria-label="Copy book link"><i data-lucide="share-2"></i></button>
            <button class="book-window__close" aria-label="Close window"><i data-lucide="x"></i></button>
				</div>
			</div>
			<div class="book-window__content">
        <div class="book-window__cover-frame">
          <img class="book-window__cover" src="" alt="" />
        </div>
				<div>
					<p class="book-window__author"></p>
					<h2 class="book-window__title"></h2>
					<p class="book-window__meta"></p>
					<hr />
					<p class="book-window__body"></p>
				</div>
			</div>
      </div>
      <div class="book-window__bottom-mask" aria-hidden="true"></div>
		`;

    const maxScrollHeight = isMobile ? 630 : 480;
    requiredElement(windowElement, ".book-window__scroll").style.maxHeight =
      `min(${maxScrollHeight}px, calc(100dvh - ${top + 8}px))`;

    renderBook(windowElement, book);
    manager.appendChild(windowElement);
    renderIcons(windowElement);
    startWindowScroll(windowElement);
    openWindows.set(slug, windowElement);
    focusWindow(windowElement);
    if (!isMobile && !shouldUseReducedMotion()) makeDraggable(windowElement);

    requiredElement(windowElement, ".book-window__close").addEventListener(
      "click",
      () => {
        openWindows.delete(windowElement.dataset.slug);
        stopWindowScroll(windowElement);
        windowElement.remove();
      },
    );
    requiredElement(windowElement, ".book-window__prev").addEventListener(
      "click",
      () => changeWindow(windowElement, -1),
    );
    requiredElement(windowElement, ".book-window__next").addEventListener(
      "click",
      () => changeWindow(windowElement, 1),
    );
    requiredElement(windowElement, ".book-window__share").addEventListener(
      "click",
      async () => {
        const route = "books";
        await navigator.clipboard.writeText(
          `${location.origin}/${route}#${windowElement.dataset.slug}`,
        );
      },
    );
    windowElement.addEventListener("pointerdown", () =>
      focusWindow(windowElement),
    );
  }

  function openWriting(slug) {
    const manager = getManager();
    if (!manager) return;

    if (openWindows.has(slug)) {
      focusWindow(openWindows.get(slug));
      return;
    }

    const isMobile = window.innerWidth < 768;
    const shouldAnimateWindow = !isMobile && !shouldUseReducedMotion();
    if (isMobile) {
      openWindows.forEach((windowElement) => {
        stopWindowScroll(windowElement);
        windowElement.remove();
      });
      openWindows.clear();
    }

    const writing = getWritings().find((item) => item.id === slug);
    if (!writing) return;

    const windowElement = document.createElement("section");
    windowElement.className = "book-window book-window--writing";
    const offset = (offsetCount++ % 5) * 40;
    const maxLeft = Math.max(8, window.innerWidth - 696);
    const maxTop = Math.max(8, window.innerHeight - 500);
    windowElement.style.left = `${Math.min(120 + offset, maxLeft)}px`;
    const top = isMobile
      ? Math.min(120 + offset, Math.max(20, window.innerHeight * 0.12))
      : Math.min(120 + offset, maxTop);
    windowElement.style.top = `${top}px`;
    if (isMobile) {
      windowElement.style.maxHeight = `calc(100dvh - ${top + 8}px)`;
      windowElement.style.transition = "none";
    }
    if (!shouldAnimateWindow) {
      windowElement.style.transition = "none";
    }
    windowElement.innerHTML = `
      <div class="book-window__scroll">
        <div class="book-window__header">
          <div class="book-window__nav">
            <button class="book-window__prev" aria-label="Previous writing"><i data-lucide="arrow-left"></i></button>
            <button class="book-window__next" aria-label="Next writing"><i data-lucide="arrow-right"></i></button>
          </div>
          <div class="book-window__actions">
            <button class="book-window__share" aria-label="Copy writing link"><i data-lucide="share-2"></i></button>
            <button class="book-window__close" aria-label="Close window"><i data-lucide="x"></i></button>
          </div>
        </div>
        <div class="book-window__content book-window__content--writing">
          <div>
            <p class="book-window__meta"></p>
            <h2 class="book-window__title"></h2>
            <div class="book-window__body"></div>
          </div>
        </div>
      </div>
      <div class="book-window__bottom-mask" aria-hidden="true"></div>
    `;

    const maxScrollHeight = isMobile ? 630 : 480;
    requiredElement(windowElement, ".book-window__scroll").style.maxHeight =
      `min(${maxScrollHeight}px, calc(100dvh - ${top + 8}px))`;

    renderWriting(windowElement, writing);
    manager.appendChild(windowElement);
    renderIcons(windowElement);
    startWindowScroll(windowElement);
    openWindows.set(slug, windowElement);
    focusWindow(windowElement);
    if (!isMobile && !shouldUseReducedMotion()) makeDraggable(windowElement);

    requiredElement(windowElement, ".book-window__close").addEventListener(
      "click",
      () => {
        openWindows.delete(windowElement.dataset.slug);
        stopWindowScroll(windowElement);
        windowElement.remove();
      },
    );
    requiredElement(windowElement, ".book-window__prev").addEventListener(
      "click",
      () => changeWindow(windowElement, -1),
    );
    requiredElement(windowElement, ".book-window__next").addEventListener(
      "click",
      () => changeWindow(windowElement, 1),
    );
    requiredElement(windowElement, ".book-window__share").addEventListener(
      "click",
      async () => {
        await navigator.clipboard.writeText(
          `${location.origin}/writings/${windowElement.dataset.slug}`,
        );
      },
    );
    windowElement.addEventListener("pointerdown", () =>
      focusWindow(windowElement),
    );
  }

  function closeAllWindows() {
    openWindows.forEach((windowElement) => {
      stopWindowScroll(windowElement);
      windowElement.remove();
    });
    openWindows.clear();
  }

  document.addEventListener("astro:before-swap", closeAllWindows);

  document.addEventListener("click", (event) => {
    const target = event.target instanceof Element ? event.target : null;

    const bookTrigger = target?.closest("[data-book-slug]");
    if (bookTrigger) {
      openBook(bookTrigger.getAttribute("data-book-slug"));
      return;
    }

    const writingTrigger = target?.closest("[data-writing-slug]");
    if (writingTrigger) {
      openWriting(writingTrigger.getAttribute("data-writing-slug"));
    }
  });
</script>
