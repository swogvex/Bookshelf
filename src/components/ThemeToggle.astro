---
import { Moon, Sun } from "lucide-astro";
---

<button
  id="theme-toggle"
  class="theme-toggle"
  type="button"
  aria-label="Toggle dark mode"
  aria-pressed="false"
>
  <span class="theme-toggle__icon theme-toggle__icon--sun" aria-hidden="true">
    <Sun size={16} strokeWidth={2} />
  </span>
  <span class="theme-toggle__icon theme-toggle__icon--moon" aria-hidden="true">
    <Moon size={16} strokeWidth={2} />
  </span>
</button>

<script is:inline>
  const root = document.documentElement;

  const applyTheme = (dark, button) => {
    root.classList.toggle("dark", dark);
    button?.setAttribute("aria-pressed", String(dark));
    button?.setAttribute(
      "aria-label",
      dark ? "Switch to light mode" : "Switch to dark mode",
    );
  };

  const initializeThemeToggle = () => {
    const button = document.getElementById("theme-toggle");
    const savedTheme = localStorage.getItem("theme");

    if (savedTheme === "dark") {
      applyTheme(true, button);
    } else if (savedTheme === "light") {
      applyTheme(false, button);
    } else {
      applyTheme(
        window.matchMedia("(prefers-color-scheme: dark)").matches,
        button,
      );
    }

    if (button) {
      button.onclick = () => {
        const nextTheme = !root.classList.contains("dark");
        applyTheme(nextTheme, button);
        localStorage.setItem("theme", nextTheme ? "dark" : "light");
      };
    }
  };

  initializeThemeToggle();
  document.addEventListener("astro:page-load", initializeThemeToggle);
</script>
